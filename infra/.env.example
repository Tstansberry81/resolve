# Local infrastructure only. Production secrets belong in Render/Supabase secret storage.
DATABASE_URL=postgresql+asyncpg://resolve:resolve-local-only@localhost:5432/resolve
REDIS_URL=redis://localhost:6379/0
RESOLVE_CONFIG_DIR=./config

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Core connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Shared with Telegram via setWebhook's secret_token. Required for the inbound
# bridge (approval buttons + /resolve); the webhook fails closed without it.
TELEGRAM_WEBHOOK_SECRET=

# --- Attachments (photos, PDFs, voice notes over Telegram) -------------------
# Images and PDFs need nothing beyond TELEGRAM_TOKEN. Voice notes are
# transcribed with whisper-1, so they need OPENAI_API_KEY above; without it a
# voice note fails with a clear message instead of silently doing nothing.

# --- Canvas (no API key — UVA doesn't issue student tokens) -------------------
# Canvas -> Calendar -> "Calendar Feed" -> copy the ICS link here. The URL alone
# grants read access to the calendar, so treat it as a secret.
CANVAS_ICS_URL=

# --- GitHub as a code host ---------------------------------------------------
# GITHUB_TOKEN already backs the vault. GITHUB_DEFAULT_REPO is the repo assumed
# when Trav asks "did the build pass?" without naming one.
GITHUB_DEFAULT_REPO=

# --- Composio connected accounts --------------------------------------------
# Pin a connected account per toolkit. REQUIRED for Spotify: two Spotify accounts
# are connected, so Composio can't choose on its own and playback calls fail with
# an account-selection error until this is set.
# COMPOSIO_ACCOUNTS={"spotify":"spotify_acture-borago"}
COMPOSIO_ACCOUNTS=

# --- Vault semantic recall ---------------------------------------------------
# Needs OPENAI_API_KEY (embeddings) + SUPABASE_URL/SUPABASE_KEY, and the
# infra/postgres/004_vault_embeddings.sql migration applied in Supabase.
# Optional override: VAULT_EMBED_MODEL (default text-embedding-3-small).

# --- Cost ceilings -----------------------------------------------------------
# Max web searches the assistant may run per turn (default 3).
ASSISTANT_WEB_MAX_USES=
